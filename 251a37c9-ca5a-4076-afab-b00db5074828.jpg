  <script type="module">import { injectIntoGlobalHook } from "/@react-refresh";
injectIntoGlobalHook(window);
window.$RefreshReg$ = () => {};
window.$RefreshSig$ = () => (type) => type;</script>

  <script type="module" src="/@vite/client"></script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Boom Pizza</title>
    
    <!-- Primary Meta Tags -->
    <meta name="title" content="Boom Pizza - پیتزایەکی جیاواز">
    <meta name="description" content="باشترین و بەتامترین پیتزا لە شار، بە خێراترین کات دەگاتە دەستت. ئێستا داوا بکە!">

    <!-- Open Graph / Facebook / Messenger -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://boompizza.com/">
    <meta property="og:title" content="Boom Pizza - پیتزایەکی جیاواز">
    <meta property="og:description" content="باشترین و بەتامترین پیتزا لە شار، بە خێراترین کات دەگاتە دەستت. ئێستا داوا بکە!">
    <meta property="og:image" content="https://cdn-icons-png.flaticon.com/512/3595/3595455.png">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://boompizza.com/">
    <meta property="twitter:title" content="Boom Pizza - پیتزایەکی جیاواز">
    <meta property="twitter:description" content="باشترین و بەتامترین پیتزا لە شار، بە خێراترین کات دەگاتە دەستت. ئێستا داوا بکە!">
    <meta property="twitter:image" content="https://cdn-icons-png.flaticon.com/512/3595/3595455.png">

    <!-- PWA & Mobile Meta Tags -->
